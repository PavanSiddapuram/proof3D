# Copy to .env and fill in. Never commit .env (CI scans for secrets).
PROOF3D_DATABASE_URL=postgresql+psycopg://proof3d:proof3d@localhost:5432/proof3d
PROOF3D_STORAGE_ROOT=./.data/storage
PROOF3D_PIPELINE_VERSION=0.1.0
# Host port for the API in docker compose.
PROOF3D_API_PORT=8000
PROOF3D_MAX_STAGE_ATTEMPTS=3
# Hourly price of the rented GPU; per-product cost is derived from measured GPU-seconds.
PROOF3D_GPU_USD_PER_HOUR=0.0

# Shopify demo store (your own store only). Admin API token with the smallest scopes needed:
# write_products, read_products, write_files.
PROOF3D_SHOPIFY_STORE_DOMAIN=
PROOF3D_SHOPIFY_ADMIN_TOKEN=

# Object storage (S3-compatible) for deployment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PROOF3D_S3_BUCKET=
PROOF3D_S3_ENDPOINT=

SENTRY_DSN=
